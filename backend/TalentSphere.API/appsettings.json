{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TalentSphereDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "TalentSphere.API",
    "Audience": "TalentSphere.Client",
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYING_TO_PRODUCTION_1234567890",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@talentsphere.local",
    "FromName": "TalentSphere AI",
    "EnableSsl": true
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
